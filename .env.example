# Copier ce fichier en .env et le compléter. Ne jamais committer .env.

# Source des données :
#   "local"    : navigateur seul, hors ligne, données de démo (un seul appareil)
#   "supabase" : serveur partagé, pour un vrai camp
VITE_DATA_BACKEND=local

# Supabase > Project Settings > API (ou « Connect »)
# Seulement l'URL et la clé anon / publishable.
# JAMAIS la clé service_role / secret ni le mot de passe de la base.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sous-dossier de publication (GitHub Pages : /nom-du-depot/). Laisser vide en local.
# VITE_BASE=/camp-caysti/
