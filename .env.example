# Copier ce fichier en .env et le compléter. Ne jamais committer .env.

# Source des données : "local" (navigateur, hors ligne, données de démo)
# ou "supabase" (quand le projet Supabase sera créé)
VITE_DATA_BACKEND=local

# Renseigner après création du projet Supabase (Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
